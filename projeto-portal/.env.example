# Token gratuito do Hugging Face (role "read"): https://huggingface.co/settings/tokens
HF_TOKEN=

# Modelo de IA usado SOMENTE quando MOCK_LLM=0.
MODEL=Qwen/Qwen2.5-7B-Instruct

# 1 = simulador Python local. Não executa um modelo de IA nem chama uma API.
MOCK_LLM=1

# 0 = Qwen pela API do Hugging Face; requer HF_TOKEN e internet.
# No checkpoint com API real, mantenha um orçamento pequeno.
# 0 = sem limite local. Na aula, recomendamos 3.
MAX_REAL_CALLS=3

# 1 = reaproveita respostas idênticas durante a sessão sem nova chamada.
LLM_CACHE=1
