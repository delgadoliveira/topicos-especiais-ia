# Token gratuito do Hugging Face (role "read"): https://huggingface.co/settings/tokens
HF_TOKEN=

# Modelo aberto usado pelo portal (padrão: Qwen/Qwen2.5-7B-Instruct)
MODEL=Qwen/Qwen2.5-7B-Instruct

# Comece com 1: modo offline determinístico, sem token, rede ou limite de API.
MOCK_LLM=1

# No checkpoint com API real, troque MOCK_LLM para 0 e mantenha um orçamento pequeno.
# 0 = sem limite local. Na aula, recomendamos 3.
MAX_REAL_CALLS=3

# 1 = reaproveita respostas idênticas durante a sessão sem nova chamada.
LLM_CACHE=1
