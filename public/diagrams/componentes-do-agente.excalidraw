{
  "type": "excalidraw",
  "version": 2,
  "source": "github-copilot",
  "elements": [
    {"id":"title","type":"text","x":80,"y":40,"width":950,"height":80,"text":"Um agente é um sistema, não apenas um prompt","fontSize":36,"fontFamily":1,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"id":"subtitle","type":"text","x":80,"y":120,"width":900,"height":55,"text":"Cinco componentes cooperam em uma execução observável e limitada.","fontSize":20,"fontFamily":1,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},

    {"id":"persona","type":"rectangle","x":80,"y":220,"width":360,"height":190,"strokeColor":"#F7630C","backgroundColor":"#FFF4CE","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"boundElements":[{"type":"text","id":"persona-text"}]},
    {"id":"persona-text","type":"text","x":105,"y":250,"width":310,"height":130,"text":"1 · PERSONA + OBJETIVO\n\nPapel, tarefa, formato e limites\n\nA dupla define","fontSize":19,"fontFamily":1,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"persona"},

    {"id":"model","type":"rectangle","x":520,"y":220,"width":360,"height":190,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"boundElements":[{"type":"text","id":"model-text"}]},
    {"id":"model-text","type":"text","x":545,"y":250,"width":310,"height":130,"text":"2 · MODELO / MOTOR\n\nSimulador offline ou Qwen opcional\n\nO framework fornece","fontSize":19,"fontFamily":1,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"model"},

    {"id":"memory","type":"rectangle","x":960,"y":220,"width":360,"height":190,"strokeColor":"#5C2D91","backgroundColor":"#E8DAEF","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"boundElements":[{"type":"text","id":"memory-text"}]},
    {"id":"memory-text","type":"text","x":985,"y":250,"width":310,"height":130,"text":"3 · MEMÓRIA\n\nDuas mensagens recentes\n\nA dupla adapta · não é cache","fontSize":19,"fontFamily":1,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"memory"},

    {"id":"tools","type":"rectangle","x":80,"y":540,"width":430,"height":200,"strokeColor":"#107C10","backgroundColor":"#DFF6DD","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"boundElements":[{"type":"text","id":"tools-text"}]},
    {"id":"tools-text","type":"text","x":105,"y":570,"width":380,"height":140,"text":"4 · TOOLS + EXECUTOR\n\nA dupla cria a tool\nO template protege com TOOLS","fontSize":19,"fontFamily":1,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"tools"},

    {"id":"loop","type":"rectangle","x":890,"y":540,"width":430,"height":200,"strokeColor":"#D13438","backgroundColor":"#FDE7E9","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"boundElements":[{"type":"text","id":"loop-text"}]},
    {"id":"loop-text","type":"text","x":915,"y":570,"width":380,"height":140,"text":"5 · LOOP DE CONTROLE\n\nMáximo de duas tentativas\nA dupla testa e explica","fontSize":19,"fontFamily":1,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"loop"},

    {"id":"events-container","type":"rectangle","x":570,"y":510,"width":260,"height":260,"strokeColor":"#495057","backgroundColor":"#F3F2F1","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"boundElements":[{"type":"text","id":"events-text"}]},
    {"id":"events-text","type":"text","x":595,"y":545,"width":210,"height":190,"text":"EXECUÇÃO OBSERVÁVEL\n\nOBSERVE\nMEMORY → ACT\nREFLECT\nSTOP","fontSize":18,"fontFamily":3,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"events-container"},

    {"id":"a1","type":"arrow","x":440,"y":315,"width":80,"height":0,"strokeColor":"#495057","strokeWidth":2,"points":[[0,0],[80,0]],"startBinding":{"elementId":"persona","focus":0,"gap":1},"endBinding":{"elementId":"model","focus":0,"gap":1}},
    {"id":"a2","type":"arrow","x":960,"y":315,"width":-80,"height":0,"strokeColor":"#495057","strokeWidth":2,"points":[[0,0],[-80,0]],"startBinding":{"elementId":"memory","focus":0,"gap":1},"endBinding":{"elementId":"model","focus":0,"gap":1}},
    {"id":"a3","type":"arrow","x":700,"y":410,"width":0,"height":100,"strokeColor":"#495057","strokeWidth":2,"points":[[0,0],[0,100]],"startBinding":{"elementId":"model","focus":0,"gap":1},"endBinding":{"elementId":"events-container","focus":0,"gap":1}},
    {"id":"a4","type":"arrow","x":510,"y":640,"width":60,"height":0,"strokeColor":"#495057","strokeWidth":2,"points":[[0,0],[60,0]],"startBinding":{"elementId":"tools","focus":0,"gap":1},"endBinding":{"elementId":"events-container","focus":0,"gap":1}},
    {"id":"a5","type":"arrow","x":830,"y":640,"width":60,"height":0,"strokeColor":"#495057","strokeWidth":2,"points":[[0,0],[60,0]],"startBinding":{"elementId":"events-container","focus":0,"gap":1},"endBinding":{"elementId":"loop","focus":0,"gap":1}},

    {"id":"footer","type":"text","x":80,"y":820,"width":1240,"height":100,"text":"E1 Persona + ReAct  ·  E2 Modelo + Tools + Loops  ·  E3 Memória\nE4 Falhas + Avaliação  ·  E5 Integração  ·  E6 Evidências + Melhoria","fontSize":18,"fontFamily":1,"strokeColor":"#000000","textAlign":"center","verticalAlign":"top"}
  ],
  "appState": {"viewBackgroundColor": "#ffffff"}
}
